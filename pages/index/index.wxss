/* pages/index/index.wxss */

.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

/* 1. 顶部总览卡片 */
.overview-card {
  background: linear-gradient(135deg, #07C160 0%, #059669 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.2);
  margin-bottom: 28rpx;
}

.overview-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.scope-tabs {
  display: flex;
  background-color: rgba(0, 0, 0, 0.16);
  padding: 4rpx;
  border-radius: 18rpx;
  gap: 4rpx;
  backdrop-filter: blur(8px);
  flex-shrink: 0;
}

.scope-tab {
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  color: #d1fae5;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.scope-tab-active {
  background-color: #ffffff;
  color: #047857;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 月份左右切换导航器样式 */
.month-nav-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.16);
  border-radius: 20rpx;
  padding: 8rpx 14rpx;
  margin-bottom: 22rpx;
  backdrop-filter: blur(8px);
}

.month-nav-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 14rpx;
  background-color: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-weight: 500;
  transition: all 0.2s ease;
}

.month-nav-btn:active {
  background-color: rgba(255, 255, 255, 0.35);
}

.nav-arrow {
  font-size: 18rpx;
  opacity: 0.9;
}

.nav-label {
  font-size: 22rpx;
}

.month-nav-current {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-current-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 0.5rpx;
}

.nav-swipe-hint {
  font-size: 18rpx;
  color: #d1fae5;
  margin-top: 2rpx;
  opacity: 0.85;
}

.overview-middle-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.overview-badge {
  background-color: rgba(255, 255, 255, 0.18);
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  color: #ecfdf5;
  font-weight: 500;
  backdrop-filter: blur(8px);
  margin-bottom: 8rpx;
}

.overview-sub {
  font-size: 22rpx;
  color: #d1fae5;
  font-weight: 500;
}

.overview-amount {
  display: block;
  font-size: 54rpx;
  font-weight: bold;
  letter-spacing: -1rpx;
  margin-top: 4rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.top-action-btn {
  height: 52rpx;
  padding: 0 18rpx;
  background-color: #ffffff;
  color: #047857;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  gap: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  white-space: nowrap;
  box-sizing: border-box;
}

.top-action-sub {
  background-color: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-weight: 500;
  box-shadow: none;
  backdrop-filter: blur(8px);
}

.overview-footer {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: #d1fae5;
}

.footer-item .val {
  color: #ffffff;
  font-weight: bold;
}

.footer-divider {
  width: 1rpx;
  height: 24rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

/* 2. 时间轴每日卡片与折叠分组 */
.timeline-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.timeline-tools-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 10rpx 12rpx 10rpx;
}

.timeline-tools-title {
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 500;
}

.timeline-tools-action {
  font-size: 22rpx;
  color: #059669;
  font-weight: bold;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background-color: #ecfdf5;
  transition: all 0.2s ease;
}

/* 2. 一级：月份折叠分组 */
.timeline-month-group {
  margin-bottom: 24rpx;
}

.month-header {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 22rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #e2e8f0;
  margin-bottom: 16rpx;
  transition: all 0.2s ease;
}

.month-header:active {
  background-color: #f8fafc;
}

.month-indicator {
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #07C160 0%, #059669 100%);
  border-radius: 4rpx;
}

.month-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #0f172a;
}

.month-amount {
  font-size: 28rpx;
  font-weight: bold;
  color: #0f172a;
}

.month-body {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.month-body-hidden,
.week-body-hidden,
.group-body-hidden {
  display: none !important;
}

/* 2. 二级：按周折叠分组容器 */
.timeline-week-group {
  background-color: #f8fafc;
  border-radius: 24rpx;
  padding: 16rpx;
  border: 1rpx solid #edf2f7;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.week-header {
  background-color: #ffffff;
  border-radius: 18rpx;
  padding: 16rpx 22rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid #e2e8f0;
  transition: all 0.2s ease;
}

.week-header:active {
  background-color: #f1f5f9;
}

.week-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.week-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #10b981;
}

.week-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1e293b;
}

.week-range {
  font-size: 20rpx;
  color: #64748b;
  background-color: #f1f5f9;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.week-badge {
  font-size: 20rpx;
  color: #94a3b8;
}

.week-header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.week-amount {
  font-size: 26rpx;
  font-weight: bold;
  color: #059669;
}

.week-arrow {
  font-size: 18rpx;
  color: #94a3b8;
  display: inline-block;
  transition: transform 0.25s ease;
}

.week-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 兼容保留 */
.timeline-group {
  margin-bottom: 16rpx;
}

.group-header {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #f1f5f9;
  margin-bottom: 16rpx;
  transition: all 0.2s ease;
}

.group-header:active {
  background-color: #f8fafc;
}

.group-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-indicator {
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #07C160 0%, #059669 100%);
  border-radius: 4rpx;
}

.group-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #0f172a;
}

.group-badge {
  font-size: 20rpx;
  color: #64748b;
  background-color: #f1f5f9;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.group-header-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.group-amount {
  font-size: 28rpx;
  font-weight: bold;
  color: #0f172a;
}

.group-arrow {
  font-size: 20rpx;
  color: #94a3b8;
  display: inline-block;
  transition: transform 0.25s ease;
}

.arrow-collapsed {
  transform: rotate(-90deg);
}

.arrow-expanded {
  transform: rotate(0deg);
}

.group-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.day-card {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid #f1f5f9;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f8fafc;
}

.date-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-indicator {
  width: 8rpx;
  height: 28rpx;
  background-color: #07C160;
  border-radius: 4rpx;
}

.date-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1e293b;
}

.weekday {
  font-size: 22rpx;
  color: #94a3b8;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.day-total {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.total-amount {
  font-size: 30rpx;
  font-weight: bold;
  color: #0f172a;
}

.day-more-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background-color: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.more-dots {
  font-size: 24rpx;
  font-weight: bold;
  color: #64748b;
  line-height: 1;
  letter-spacing: 2rpx;
  margin-top: -6rpx;
}

/* 条目清单与小表情 */
.items-list {
  padding: 8rpx 0;
}

.bill-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid #fafafa;
  border-radius: 14rpx;
  transition: background-color 0.15s ease;
}

.bill-item-hover {
  background-color: #f8fafc;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.item-edit-arrow {
  font-size: 28rpx;
  color: #cbd5e1;
  font-weight: 300;
  line-height: 1;
}

.bill-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.emoji-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f8fafc;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.emoji-breakfast { background-color: #fff7ed; }
.emoji-lunch     { background-color: #eff6ff; }
.emoji-dinner    { background-color: #fef3c7; }
.emoji-snack     { background-color: #e0e7ff; }
.emoji-market    { background-color: #ecfdf5; }
.emoji-shopping  { background-color: #fff1f2; }
.emoji-drink     { background-color: #fdf4ff; }
.emoji-fruit     { background-color: #fdf2f8; }
.emoji-traffic   { background-color: #f0fdfa; }

.emoji-char {
  font-size: 30rpx;
  line-height: 1;
}

.item-name {
  font-size: 26rpx;
  color: #334155;
  font-weight: 500;
}

.item-amount {
  font-size: 28rpx;
  font-weight: bold;
  color: #1e293b;
}

/* 读书与旅行随记卡片 */
.life-block {
  margin: 12rpx 0;
  padding: 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.life-icon {
  font-size: 32rpx;
  line-height: 1.2;
}

.life-content {
  flex: 1;
}

.life-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.life-title {
  font-size: 24rpx;
  font-weight: bold;
}

.life-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.life-desc {
  font-size: 22rpx;
  line-height: 1.4;
  display: block;
}

.book-block {
  background-color: #fefce8;
  border: 1rpx solid #fef08a;
}
.book-block .life-title { color: #854d0e; }
.book-block .badge-book { background-color: #ffffff; color: #a16207; }
.book-block .life-desc  { color: #713f12; }

.travel-block {
  background-color: #f0f9ff;
  border: 1rpx solid #e0f2fe;
}
.travel-block .life-title { color: #0369a1; }
.travel-block .badge-travel { background-color: #ffffff; color: #0284c7; }
.travel-block .life-desc  { color: #075985; }

.life-block .item-edit-arrow {
  align-self: center;
  font-size: 28rpx;
  color: #94a3b8;
  margin-left: 8rpx;
}

/* 底部自定义打卡胶囊 */
.card-footer {
  margin-top: 8rpx;
  padding: 12rpx 10rpx;
  border-top: 1rpx dashed #f1f5f9;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  transition: background-color 0.15s ease;
}

.footer-hover {
  background-color: #f8fafc;
}

.note-content {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  flex-shrink: 0;
}

.note-text {
  color: #334155;
  font-weight: 500;
}

.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
}

.tag-capsule {
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  font-weight: bold;
  border-radius: 12rpx;
  background-color: #f1f5f9;
  color: #334155;
  border: 1rpx solid #e2e8f0;
}

.habit-edit-badge {
  font-size: 22rpx;
  opacity: 0.5;
  padding: 4rpx;
  flex-shrink: 0;
}

/* 空状态与底部提示 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}
.empty-text {
  font-size: 24rpx;
  color: #94a3b8;
}

.bottom-tip {
  text-align: center;
  padding: 30rpx 0;
  font-size: 22rpx;
  color: #cbd5e1;
}

/* 3. 悬浮加号按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 104rpx;
  height: 104rpx;
  background-color: #07C160;
  border-radius: 52rpx;
  box-shadow: 0 10rpx 28rpx rgba(7, 193, 96, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
}

.fab-icon {
  color: #ffffff;
  font-size: 52rpx;
  line-height: 1;
  margin-top: -4rpx;
}

/* 4. 弹窗样式 */
.modal-mask {
  position: fixed;
  inset: 0;
  background-color: rgba(15, 23, 42, 0.45);
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  visibility: hidden;
  opacity: 0;
  transition: all 0.25s ease-out;
}

.modal-show {
  visibility: visible;
  opacity: 1;
}

.modal-sheet {
  background-color: #ffffff;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 32rpx 32rpx 0 32rpx;
  padding-bottom: env(safe-area-inset-bottom, 32rpx);
  transform: translateY(100%);
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.modal-show .modal-sheet {
  transform: translateY(0);
}

.modal-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.modal-scroll-body {
  width: 100%;
  max-height: calc(86vh - 120rpx);
  box-sizing: border-box;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 40rpx;
}

.mode-tabs {
  display: flex;
  background-color: #f1f5f9;
  padding: 6rpx;
  border-radius: 20rpx;
  gap: 4rpx;
  overflow-x: auto;
}

.mode-tab {
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.mode-tab-active {
  background-color: #ffffff;
  color: #07C160;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.modal-close-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background-color: #f1f5f9;
  color: #94a3b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 日期微调条 */
.date-selector-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #f8fafc;
  padding: 16rpx 24rpx;
  border-radius: 18rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
}

.date-selector-label {
  color: #64748b;
}

.date-picker-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #ffffff;
  border: 1rpx solid #e2e8f0;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  font-weight: bold;
  color: #1e293b;
}

.arrow {
  font-size: 18rpx;
  color: #94a3b8;
}

/* 记账表单 */
.amount-card {
  background-color: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.amount-label {
  font-size: 24rpx;
  color: #94a3b8;
}

.amount-input-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.currency-symbol {
  font-size: 32rpx;
  font-weight: bold;
  color: #07C160;
}

.amount-input {
  width: 260rpx;
  text-align: right;
  font-size: 48rpx;
  font-weight: 900;
  color: #0f172a;
}

/* 分类点选网格 */
.category-section {
  margin-bottom: 20rpx;
}

.cat-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.cat-section-title {
  font-size: 22rpx;
  color: #94a3b8;
}

.cat-section-subtip {
  font-size: 20rpx;
  color: #94a3b8;
}

.cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.cat-card {
  position: relative;
  background-color: #f8fafc;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  padding: 16rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  transition: all 0.2s ease;
}

.cat-custom-tag {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  font-size: 16rpx;
  background-color: #fef3c7;
  color: #b45309;
  padding: 2rpx 6rpx;
  border-radius: 6rpx;
  font-weight: bold;
  line-height: 1;
}

.cat-card-selected {
  background-color: #ecfdf5;
  border-color: #07C160;
}

.cat-emoji {
  font-size: 38rpx;
